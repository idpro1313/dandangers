# Скопируйте в .env и подставьте пути (абсолютный путь к корню сайта на сервере — папка проекта с index.php, docker/ и т.д.)
# cp env.example .env

# Каталог с index.php, content/, docker/ и т.д.
# Типичный путь при клоне в каталог sites (webserver): /opt/webserver/sites/dandangers
SITE_ROOT=/opt/webserver/sites/dandangers

# Имя контейнера и тег собранного образа (nginx+PHP в одном)
SITE_CONTAINER_NAME=dandangers_web
WEB_IMAGE_NAME=dandangers-web:latest

# Traefik: имя роутера (латиница, без пробелов) — должно быть уникальным на хосте
TRAEFIK_ROUTER=dandangers

# Правило Host для Traefik (обратные кавычки вокруг доменов обязательны)
TRAEFIK_RULE=Host(`dandangers.ru`) || Host(`www.dandangers.ru`)

# HTTPS entrypoint (часто websecure)
TRAEFIK_ENTRYPOINT_HTTPS=websecure

# Resolver Let's Encrypt в Traefik (в шаблоне webserver обычно le)
TRAEFIK_CERT_RESOLVER=le
